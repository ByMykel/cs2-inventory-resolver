{
  "name": "cs2-inventory-resolver",
  "version": "0.3.4",
  "description": "Resolve CS2 Game Coordinator protobuf items into human-readable names, images, and categories",
  "keywords": [
    "cs2",
    "csgo",
    "counter-strike",
    "steam",
    "inventory",
    "skins",
    "game-coordinator",
    "protobuf",
    "resolver",
    "valve"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "data/"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  }
}
